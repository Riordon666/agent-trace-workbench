# Additional HTTP and WebSocket security allowlists, separated by commas.
# Host values must not include a scheme or path. Origin values must be complete origins without a trailing slash.
# Keep these unset for the default local-only deployment.
# WORKBENCH_ALLOWED_HOSTS=trace.example.com
# WORKBENCH_ALLOWED_ORIGINS=https://trace.example.com

# The atw CLI stores sessions, certificates, wallpapers, and exports in a per-user data directory.
# Override its root or individual paths when needed.
# ATW_DATA_DIR=D:\\agent-trace-workbench-data
# WORKBENCH_SESSIONS_DIR=D:\\agent-trace-workbench-data\\sessions
# WORKBENCH_CERT_DIR=D:\\agent-trace-workbench-data\\certs

# Optional additional terminal working roots, separated by the platform path delimiter.
# TERMINAL_ALLOWED_ROOTS=D:\\projects;E:\\scratch

# Optional default parent directory for annotation package folders.
# WORKBENCH_ANNOTATION_EXPORT_DIR=D:\\annotation-exports

# Optional USD standard-rate catalog override for local cost estimation.
# Unknown providers/models remain unavailable instead of using a guessed rate.
# WORKBENCH_PRICING_FILE=D:\\agent-trace-workbench-data\\model-pricing.json
